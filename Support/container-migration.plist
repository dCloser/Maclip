<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- On the sandboxed app's first launch, macOS moves the history saved by the earlier,
	     unsandboxed "ClipboardHistory" builds into Maclip's container. -->
	<key>Move</key>
	<array>
		<string>${ApplicationSupport}/ClipboardHistory</string>
	</array>
</dict>
</plist>
