<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required for the Mac App Store; also used for the Developer ID / DMG build so both
	     behave the same. Maclip needs no other entitlements: the global hotkey, clipboard
	     access, its own data folder and posting the paste keystroke all work in the sandbox. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
